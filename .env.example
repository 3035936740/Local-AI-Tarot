#协议格式: ollama 或 openai（任意 OpenAI 兼容网关）
TAROT_PROVIDER=openai
TAROT_URL=https://api.deepseek.com/v1
TAROT_MODEL=deepseek-v4-pro
TAROT_API_KEY=replace_with_your_apikey

# 韦特牌里大阿尔卡那的编号上限
TAROT_MAJOR_ARCANA_MAX_ID=21
# 十二星座的英文 key , 和 tarot_all_cn.json 里 zodiacs 的键一致
TAROT_ZODIAC_KEYS=Aries,Leo,Sagittarius,Taurus,Virgo,Capricorn,Gemini,Libra,Aquarius,Cancer,Scorpio,Pisces
# 牌阵中文名过滤词
TAROT_NAME_SUFFIXES=牌阵,展开法,展开,阵列
